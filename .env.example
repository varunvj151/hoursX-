# HoursX configuration (copy to .env and adjust)

# --- server ---
HOURSX_ENVIRONMENT=dev
HOURSX_HOST=0.0.0.0
HOURSX_PORT=8400
HOURSX_PUBLIC_URL=http://localhost:8400

# --- persistence ---
HOURSX_DATABASE_URL=postgresql+asyncpg://hoursx:hoursx@localhost:5432/hoursx
HOURSX_REDIS_URL=redis://localhost:6379/0

# --- auth (set a strong random secret in production) ---
HOURSX_JWT_SECRET=change-me-to-a-long-random-string
HOURSX_ALLOW_OPEN_REGISTRATION=true

# --- execution ---
# inline: runs execute in the API process (dev). arq: dedicated worker (prod).
HOURSX_TASK_BACKEND=arq
HOURSX_WORKSPACE_ROOT=./workspaces

# --- model providers (leave unset to disable a provider) ---
HOURSX_ANTHROPIC_API_KEY=
HOURSX_OPENAI_API_KEY=
# Any OpenAI-compatible local endpoint (Ollama, vLLM, LM Studio):
HOURSX_LOCAL_BASE_URL=
# JSON alias map, e.g. {"fast": "anthropic/claude-haiku-4-5", "deep": "anthropic/claude-sonnet-5", "embed": "openai/text-embedding-3-small"}
# HOURSX_MODEL_ALIASES=

# --- kernel / host operations (off by default) ---
# Reading kernel and host state:
HOURSX_SYSTEM_OPS=false
# Allowing approved, reversible changes (sysctl, signals, services):
HOURSX_SYSTEM_MUTATIONS=false
# Extra sysctl keys this deployment permits, beyond the reviewed default set:
# HOURSX_SYSTEM_SYSCTL_ALLOWLIST=["net.ipv6.conf.all.forwarding"]

# --- plugins ---
HOURSX_PLUGIN_DIR=./plugins
HOURSX_MARKETPLACE_INDEX_URL=

# --- console (Next.js) ---
NEXT_PUBLIC_HOURSX_API_URL=http://localhost:8400
